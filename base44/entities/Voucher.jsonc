{
  "name": "Voucher",
  "type": "object",
  "properties": {
    "code": {
      "type": "string"
    },
    "discount_type": {
      "type": "string",
      "enum": [
        "percentage",
        "fixed_amount"
      ],
      "default": "percentage"
    },
    "discount_percent": {
      "type": "number",
      "default": 10
    },
    "discount_amount": {
      "type": "number",
      "description": "Fixed discount amount in naira (used when discount_type is fixed_amount)"
    },
    "max_uses": {
      "type": "number"
    },
    "uses": {
      "type": "number",
      "default": 0
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "description": {
      "type": "string"
    },
    "assigned_to_email": {
      "type": "string",
      "description": "Restrict voucher to a specific customer email"
    },
    "expiry_date": {
      "type": "string",
      "format": "date-time"
    },
    "birthday_reward_id": {
      "type": "string",
      "description": "Linked BirthdayReward record id"
    },
    "one_time_use": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "code"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}