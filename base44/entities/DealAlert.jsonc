{
  "name": "DealAlert",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "weekly_deal",
        "discount_code",
        "announcement"
      ],
      "default": "announcement"
    },
    "image": {
      "type": "string"
    },
    "link": {
      "type": "string"
    },
    "voucher_code": {
      "type": "string"
    },
    "discount_percent": {
      "type": "number"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "title",
    "body"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}