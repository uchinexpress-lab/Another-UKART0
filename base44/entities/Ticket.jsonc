{
  "name": "Ticket",
  "type": "object",
  "properties": {
    "subject": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "order",
        "delivery",
        "payment",
        "account",
        "other",
        "order_issue",
        "missing_item",
        "wrong_item",
        "damaged_item",
        "late_delivery",
        "delivery_problem",
        "payment_issue",
        "refund_request",
        "cancellation_request",
        "product_issue",
        "rider_issue",
        "general_question"
      ],
      "default": "other"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "closed",
        "new",
        "in_progress",
        "waiting_customer",
        "waiting_internal",
        "resolved"
      ],
      "default": "open"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium"
    },
    "user_email": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "order_id": {
      "type": "string"
    },
    "order_number": {
      "type": "string"
    },
    "assigned_staff_id": {
      "type": "string"
    },
    "assigned_staff_name": {
      "type": "string"
    },
    "assigned_rider_id": {
      "type": "string"
    },
    "assigned_rider_name": {
      "type": "string"
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "closed_reason": {
      "type": "string",
      "enum": [
        "manual",
        "auto_closed_inactivity"
      ],
      "default": "manual"
    },
    "internal_notes": {
      "type": "string"
    }
  },
  "required": [
    "subject"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}