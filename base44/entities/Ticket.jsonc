{
  "name": "Ticket",
  "type": "object",
  "properties": {
    "subject": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "order",
        "delivery",
        "payment",
        "account",
        "other"
      ],
      "default": "other"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "closed"
      ],
      "default": "open"
    },
    "user_email": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time"
    },
    "closed_reason": {
      "type": "string",
      "enum": [
        "manual",
        "auto_closed_inactivity"
      ],
      "default": "manual"
    }
  },
  "required": [
    "subject"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}