{
  "name": "Order",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "delivery_fee": {
      "type": "number"
    },
    "discount": {
      "type": "number",
      "default": 0
    },
    "voucher_code": {
      "type": "string"
    },
    "total": {
      "type": "number"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "customer_address": {
      "type": "string"
    },
    "landmark": {
      "type": "string"
    },
    "payment_method": {
      "type": "string",
      "default": "Cash on Delivery"
    },
    "payment_status": {
      "type": "string",
      "default": "Pending"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "processing",
        "ready",
        "on_the_way",
        "delivered",
        "cancelled"
      ],
      "default": "new"
    },
    "admin_notified": {
      "type": "boolean",
      "default": false
    },
    "confirmation_email_sent": {
      "type": "boolean",
      "default": false
    },
    "last_status_notified": {
      "type": "string"
    }
  },
  "required": [
    "order_number",
    "items",
    "total"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}