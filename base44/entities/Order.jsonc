{
  "name": "Order",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "delivery_fee": {
      "type": "number"
    },
    "discount": {
      "type": "number",
      "default": 0
    },
    "voucher_code": {
      "type": "string"
    },
    "total": {
      "type": "number"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "customer_address": {
      "type": "string"
    },
    "landmark": {
      "type": "string"
    },
    "payment_method": {
      "type": "string",
      "default": "Pay Online"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "Pending",
        "Processing",
        "Paid",
        "Failed",
        "Cancelled",
        "Refunded"
      ],
      "default": "Pending"
    },
    "paystack_reference": {
      "type": "string",
      "description": "Unique Paystack transaction reference"
    },
    "paystack_transaction_id": {
      "type": "number",
      "description": "Paystack transaction ID"
    },
    "payment_channel": {
      "type": "string",
      "description": "Payment channel used (card, bank_transfer, ussd, etc.)"
    },
    "payment_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "paystack_mode": {
      "type": "string",
      "enum": [
        "test",
        "live"
      ],
      "description": "Whether the payment was processed in test or live mode"
    },
    "paystack_response": {
      "type": "object",
      "description": "Full Paystack transaction response for audit"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "processing",
        "ready",
        "on_the_way",
        "delivered",
        "cancelled"
      ],
      "default": "new"
    },
    "admin_notified": {
      "type": "boolean",
      "default": false
    },
    "confirmation_email_sent": {
      "type": "boolean",
      "default": false
    },
    "last_status_notified": {
      "type": "string"
    }
  },
  "required": [
    "order_number",
    "items",
    "total"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff_admin"
          }
        },
        {
          "user_condition": {
            "role": "operations"
          }
        },
        {
          "user_condition": {
            "role": "support"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff_admin"
          }
        },
        {
          "user_condition": {
            "role": "operations"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}