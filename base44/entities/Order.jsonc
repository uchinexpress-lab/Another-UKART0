{
  "name": "Order",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string",
            "description": "Linked Product entity id (server-authored)"
          },
          "product_name": {
            "type": "string",
            "description": "Base product name (for reorder reconstruction)"
          },
          "variant_label": {
            "type": "string",
            "description": "Selected variant label (for reorder reconstruction)"
          },
          "name": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "addons": {
            "type": "array",
            "description": "Selected preparation add-ons (server-calculated prices)",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "price": {
                  "type": "number"
                }
              }
            }
          },
          "addons_total": {
            "type": "number",
            "description": "Sum of add-on prices for this line item (server-calculated)"
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "delivery_fee": {
      "type": "number"
    },
    "discount": {
      "type": "number",
      "default": 0
    },
    "voucher_code": {
      "type": "string"
    },
    "total": {
      "type": "number"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "customer_address": {
      "type": "string"
    },
    "landmark": {
      "type": "string"
    },
    "payment_method": {
      "type": "string",
      "default": "Pay Online"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "Pending",
        "Processing",
        "Paid",
        "Failed",
        "Abandoned",
        "Cancelled",
        "Refunded"
      ],
      "enumColors": [
        "yellow",
        "blue",
        "green",
        "red",
        "gray",
        "gray",
        "purple"
      ],
      "default": "Pending",
      "description": "Payment state only \u2014 independent of fulfilment status"
    },
    "paystack_reference": {
      "type": "string",
      "description": "Unique Paystack transaction reference"
    },
    "paystack_transaction_id": {
      "type": "number",
      "description": "Paystack transaction ID"
    },
    "payment_channel": {
      "type": "string",
      "description": "Payment channel used (card, bank_transfer, ussd, etc.)"
    },
    "payment_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "paystack_mode": {
      "type": "string",
      "enum": [
        "test",
        "live"
      ],
      "description": "Whether the payment was processed in test or live mode"
    },
    "paystack_response": {
      "type": "object",
      "description": "Full Paystack transaction response for audit"
    },
    "status": {
      "type": "string",
      "enum": [
        "awaiting_payment",
        "new",
        "processing",
        "ready",
        "on_the_way",
        "delivered",
        "cancelled"
      ],
      "enumColors": [
        "yellow",
        "gray",
        "blue",
        "blue",
        "blue",
        "green",
        "red"
      ],
      "default": "awaiting_payment",
      "description": "Fulfilment state only \u2014 payment state lives in payment_status"
    },
    "admin_notified": {
      "type": "boolean",
      "default": false
    },
    "confirmation_email_sent": {
      "type": "boolean",
      "default": false
    },
    "last_status_notified": {
      "type": "string"
    },
    "referral_id": {
      "type": "string",
      "description": "Linked Referral record id applied to this order (for reward finalization on payment)"
    },
    "referral_type": {
      "type": "string",
      "enum": [
        "referred",
        "referrer"
      ],
      "description": "Whether the customer was the referred user or the referrer for the applied reward"
    },
    "is_first_order": {
      "type": "boolean",
      "default": false,
      "description": "Whether this order received the first-order promotion discount"
    },
    "first_order_discount": {
      "type": "number",
      "default": 0,
      "description": "First-order discount amount applied to this order"
    },
    "first_order_free_delivery": {
      "type": "boolean",
      "default": false,
      "description": "Whether free delivery was applied via the first-order promotion"
    }
  },
  "required": [
    "order_number",
    "items",
    "total"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}