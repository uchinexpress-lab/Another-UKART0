{
  "name": "PromotionSetting",
  "type": "object",
  "properties": {
    "first_order_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Master switch for the first-order discount promotion"
    },
    "first_order_discount": {
      "type": "number",
      "default": 500,
      "description": "Discount amount in naira applied to a customer's first eligible order"
    },
    "free_delivery_threshold": {
      "type": "number",
      "default": 30000,
      "description": "Subtotal threshold for free delivery on first orders only"
    },
    "first_order_free_delivery_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether first orders qualify for free delivery at the threshold"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}