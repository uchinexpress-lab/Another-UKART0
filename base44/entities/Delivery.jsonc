{
  "name": "Delivery",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string"
    },
    "order_number": {
      "type": "string"
    },
    "order_total": {
      "type": "number"
    },
    "order_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "price": {
            "type": "number"
          }
        }
      }
    },
    "rider_id": {
      "type": "string",
      "description": "Rider entity record id"
    },
    "rider_user_id": {
      "type": "string",
      "description": "Rider's User account id (for RLS)"
    },
    "rider_name": {
      "type": "string"
    },
    "rider_phone": {
      "type": "string"
    },
    "rider_photo": {
      "type": "string"
    },
    "customer_email": {
      "type": "string",
      "description": "Customer email (for RLS)"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "customer_address": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "assigned",
        "accepted",
        "preparing",
        "ready_for_pickup",
        "picked_up",
        "on_the_way",
        "arriving_soon",
        "delivered",
        "cancelled"
      ],
      "default": "pending"
    },
    "pickup_address": {
      "type": "string"
    },
    "pickup_lat": {
      "type": "number"
    },
    "pickup_lng": {
      "type": "number"
    },
    "delivery_lat": {
      "type": "number"
    },
    "delivery_lng": {
      "type": "number"
    },
    "latest_lat": {
      "type": "number"
    },
    "latest_lng": {
      "type": "number"
    },
    "last_location_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "estimated_delivery_at": {
      "type": "string",
      "format": "date-time"
    },
    "estimated_minutes": {
      "type": "number"
    },
    "last_eta_update": {
      "type": "string",
      "format": "date-time"
    },
    "eta_status": {
      "type": "string",
      "enum": [
        "on_time",
        "delayed",
        "arriving_soon",
        "arrived",
        "delivered",
        "unknown"
      ],
      "default": "unknown"
    },
    "arriving_soon_at": {
      "type": "string",
      "format": "date-time"
    },
    "delivered_at": {
      "type": "string",
      "format": "date-time"
    },
    "is_test_mode": {
      "type": "boolean",
      "default": false
    },
    "test_progress": {
      "type": "string",
      "description": "Simulation progress marker for test mode"
    }
  },
  "required": [
    "order_id",
    "order_number"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "data.rider_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.rider_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}