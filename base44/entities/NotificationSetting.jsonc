{
  "name": "NotificationSetting",
  "type": "object",
  "properties": {
    "business_email": {
      "type": "string",
      "default": "ukartfreshventures@gmail.com"
    },
    "enable_business_email": {
      "type": "boolean",
      "default": true
    },
    "enable_customer_confirmation": {
      "type": "boolean",
      "default": true
    },
    "enable_customer_status_emails": {
      "type": "boolean",
      "default": true
    }
  },
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff_admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff_admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "required": []
}