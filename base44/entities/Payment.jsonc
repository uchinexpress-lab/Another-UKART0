{
  "name": "Payment",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string",
      "description": "Linked Order record id"
    },
    "order_number": {
      "type": "string"
    },
    "reference": {
      "type": "string",
      "description": "Unique Paystack transaction reference (UKART_YYYYMMDD_NNNN_XXXXXX)"
    },
    "paystack_transaction_id": {
      "type": "number"
    },
    "amount": {
      "type": "number",
      "description": "Amount in naira"
    },
    "currency": {
      "type": "string",
      "default": "NGN"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "paid",
        "failed",
        "abandoned",
        "cancelled",
        "refunded"
      ],
      "enumColors": [
        "yellow",
        "blue",
        "green",
        "red",
        "gray",
        "gray",
        "purple"
      ],
      "default": "pending"
    },
    "customer_email": {
      "type": "string",
      "description": "Customer email (for RLS)"
    },
    "customer_name": {
      "type": "string"
    },
    "payment_channel": {
      "type": "string",
      "description": "card, bank_transfer, ussd, mobile_money, etc."
    },
    "paystack_response": {
      "type": "object",
      "description": "Full Paystack transaction response for audit"
    },
    "mode": {
      "type": "string",
      "enum": [
        "test",
        "live"
      ],
      "default": "test"
    },
    "initialized_at": {
      "type": "string",
      "format": "date-time"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "order_id",
    "reference",
    "amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}