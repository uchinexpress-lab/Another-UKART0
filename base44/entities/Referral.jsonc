{
  "name": "Referral",
  "type": "object",
  "properties": {
    "referrer_id": {
      "type": "string"
    },
    "referred_email": {
      "type": "string"
    },
    "referred_user_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "first_order_placed",
        "rewarded"
      ],
      "default": "pending"
    },
    "referred_rewarded": {
      "type": "boolean",
      "default": false
    },
    "referrer_rewarded": {
      "type": "boolean",
      "default": false
    },
    "reward_amount": {
      "type": "number",
      "default": 1000
    }
  },
  "required": [
    "referrer_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.referrer_id": "{{user.id}}"
        },
        {
          "data.referred_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}