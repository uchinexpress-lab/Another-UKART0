{
  "name": "HomepageSection",
  "type": "object",
  "properties": {
    "section": {
      "type": "string",
      "enum": [
        "weekly_deals",
        "more_to_explore"
      ]
    },
    "product_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "section"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}