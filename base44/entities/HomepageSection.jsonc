{
  "name": "HomepageSection",
  "type": "object",
  "properties": {
    "section": {
      "type": "string",
      "enum": [
        "weekly_deals",
        "more_to_explore"
      ]
    },
    "product_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "section"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff_admin"
          }
        },
        {
          "user_condition": {
            "role": "content"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff_admin"
          }
        },
        {
          "user_condition": {
            "role": "content"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff_admin"
          }
        },
        {
          "user_condition": {
            "role": "content"
          }
        }
      ]
    }
  }
}