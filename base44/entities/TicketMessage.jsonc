{
  "name": "TicketMessage",
  "type": "object",
  "properties": {
    "ticket_id": {
      "type": "string"
    },
    "ticket_owner_id": {
      "type": "string"
    },
    "sender": {
      "type": "string",
      "enum": [
        "user",
        "admin"
      ]
    },
    "body": {
      "type": "string"
    }
  },
  "required": [
    "ticket_id",
    "sender",
    "body"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.ticket_owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.ticket_owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}