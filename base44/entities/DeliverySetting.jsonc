{
  "name": "DeliverySetting",
  "type": "object",
  "properties": {
    "island_fee": {
      "type": "number",
      "default": 3000,
      "description": "Delivery fee for Lagos Island orders (naira)"
    },
    "mainland_fee": {
      "type": "number",
      "default": 5000,
      "description": "Delivery fee for orders outside Lagos Island at or above the threshold (naira)"
    },
    "mainland_threshold": {
      "type": "number",
      "default": 10000,
      "description": "Subtotal from which the outside-Lagos-Island fee applies (naira)"
    },
    "discounts_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Master switch for the delivery discount"
    },
    "first_order_discount_percent": {
      "type": "number",
      "default": 65,
      "description": "Percent taken off a new customer's first delivery"
    },
    "repeat_discount_percent": {
      "type": "number",
      "default": 50,
      "description": "Percent taken off every delivery after the first"
    },
    "first_order_min_subtotal": {
      "type": "number",
      "default": 4900,
      "description": "Minimum subtotal to qualify for the first-delivery discount (naira)"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}