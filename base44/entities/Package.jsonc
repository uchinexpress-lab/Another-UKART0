{
  "name": "Package",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "description_long": {
      "type": "string",
      "description": "Full detailed description shown on the package detail page"
    },
    "image": {
      "type": "string"
    },
    "image_zoom": {
      "type": "number",
      "default": 1
    },
    "image_pos_x": {
      "type": "number",
      "default": 50
    },
    "image_pos_y": {
      "type": "number",
      "default": 50
    },
    "image_fit_mode": {
      "type": "string",
      "enum": [
        "contain",
        "cover"
      ],
      "default": "contain"
    },
    "starting_price": {
      "type": "number"
    },
    "total_price": {
      "type": "number"
    },
    "original_total": {
      "type": "number"
    },
    "item_count": {
      "type": "number"
    },
    "badge": {
      "type": "string"
    },
    "delivery_time": {
      "type": "string"
    },
    "prep_time": {
      "type": "string"
    },
    "group": {
      "type": "string",
      "enum": [
        "essentials",
        "meal_kits"
      ],
      "default": "essentials"
    },
    "serves": {
      "type": "string"
    },
    "stock_status": {
      "type": "string",
      "enum": [
        "in_stock",
        "low_stock",
        "out_of_stock"
      ],
      "default": "in_stock"
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "description": "Mark this package as featured for homepage/spotlight placement"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "quantity": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "product_id": {
            "type": "string",
            "description": "Linked Product entity id"
          },
          "active": {
            "type": "boolean",
            "default": true,
            "description": "Included in the package (toggle off to exclude without deleting)"
          },
          "display_order": {
            "type": "number"
          },
          "optional": {
            "type": "boolean",
            "default": false,
            "description": "Customer can choose whether to include this item"
          }
        }
      }
    },
    "cooking_instructions": {
      "type": "string"
    },
    "cooking_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "type": "number"
          },
          "title": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "image": {
            "type": "string"
          }
        }
      }
    },
    "optional_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "product_id": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "active": {
            "type": "boolean",
            "default": true
          }
        }
      }
    },
    "optional_categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "display_order": {
      "type": "number"
    },
    "addons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "available": {
            "type": "boolean",
            "default": true
          }
        }
      }
    },
    "proteins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "available": {
            "type": "boolean",
            "default": true
          }
        }
      }
    },
    "extras": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "available": {
            "type": "boolean",
            "default": true
          }
        }
      }
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}