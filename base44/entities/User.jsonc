{
  "properties": {
    "role": {
      "type": "string",
      "description": "Base44 authentication role. Only 'admin' (all Ukart staff), 'user' (customers), or 'rider'. Never store custom Ukart staff positions here \u2014 use staffRole.",
      "enum": [
        "admin",
        "user",
        "rider"
      ]
    },
    "staffRole": {
      "type": "string",
      "description": "Ukart internal staff role for admin-level permissions. Only meaningful when role = 'admin'. Controls which Admin Dashboard pages this staff member can access.",
      "enum": [
        "super_admin",
        "support",
        "operations",
        "content_manager",
        "finance",
        "rider_manager"
      ]
    },
    "phone": {
      "type": "string"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date",
      "description": "Customer date of birth (YYYY-MM-DD). Used for birthday rewards."
    },
    "avatar_url": {
      "type": "string"
    },
    "saved_addresses": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "saved_cards": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "notification_preferences": {
      "type": "object"
    },
    "language": {
      "type": "string"
    },
    "deletion_requested": {
      "type": "boolean"
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}