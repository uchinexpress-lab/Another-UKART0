{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "original_price": {
      "type": "number"
    },
    "image": {
      "type": "string"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "category_id": {
      "type": "string"
    },
    "category_name": {
      "type": "string"
    },
    "category_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "subcategory": {
      "type": "string"
    },
    "product_type": {
      "type": "string",
      "enum": [
        "grocery",
        "meal_kit",
        "package"
      ],
      "default": "grocery"
    },
    "rating": {
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "description_long": {
      "type": "string"
    },
    "unit": {
      "type": "string"
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "price": {
            "type": "number"
          },
          "original_price": {
            "type": "number"
          },
          "stock_status": {
            "type": "string",
            "enum": [
              "in_stock",
              "low_stock",
              "out_of_stock"
            ],
            "default": "in_stock"
          },
          "stock_quantity": {
            "type": "number"
          },
          "low_stock_threshold": {
            "type": "number"
          }
        }
      }
    },
    "stock_status": {
      "type": "string",
      "enum": [
        "in_stock",
        "low_stock",
        "out_of_stock"
      ],
      "default": "in_stock"
    },
    "stock_quantity": {
      "type": "number"
    },
    "low_stock_threshold": {
      "type": "number",
      "default": 5
    },
    "is_hidden": {
      "type": "boolean",
      "default": false
    },
    "serves": {
      "type": "string"
    },
    "prep_time": {
      "type": "string"
    },
    "cooking_instructions": {
      "type": "string"
    },
    "optional_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "available": {
            "type": "boolean",
            "default": true
          }
        }
      }
    },
    "addons": {
      "type": "array",
      "description": "Custom preparation services (cut, slice, grind, etc.) that customers can add to this product",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique add-on identifier"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "default": 0
          },
          "active": {
            "type": "boolean",
            "default": true
          },
          "display_order": {
            "type": "number"
          }
        }
      }
    },
    "is_best_seller": {
      "type": "boolean"
    },
    "is_weekly_deal": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "coming_soon"
      ],
      "default": "active"
    }
  },
  "required": [
    "name",
    "price"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}