{
  "name": "Banner",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "location": {
      "type": "string",
      "enum": [
        "home",
        "meal_kits",
        "promotions",
        "categories"
      ],
      "default": "home"
    },
    "image": {
      "type": "string"
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "zoom": {
      "type": "number",
      "default": 1
    },
    "pos_x": {
      "type": "number",
      "default": 50
    },
    "pos_y": {
      "type": "number",
      "default": 50
    },
    "fit_mode": {
      "type": "string",
      "enum": [
        "contain",
        "cover"
      ],
      "default": "cover"
    },
    "link": {
      "type": "string"
    },
    "auto_slide": {
      "type": "boolean",
      "default": true
    },
    "slide_duration": {
      "type": "number",
      "default": 5
    }
  },
  "required": [
    "name",
    "location",
    "image"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}