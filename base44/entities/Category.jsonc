{
  "name": "Category",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "display_order": {
      "type": "number"
    },
    "is_hidden": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff_admin"
          }
        },
        {
          "user_condition": {
            "role": "content"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff_admin"
          }
        },
        {
          "user_condition": {
            "role": "content"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff_admin"
          }
        },
        {
          "user_condition": {
            "role": "content"
          }
        }
      ]
    }
  }
}