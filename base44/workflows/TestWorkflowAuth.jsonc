{
  "name": "Test Workflow Auth",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "one_time",
      "cron_expression": null,
      "one_time_date": "2026-10-01T11:03:00Z",
      "timezone": "Africa/Lagos",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Temporary diagnostic \u2014 inspects the auth context the workflow runtime provides when invoking a backend function. Auto-archives after one run.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "test_workflow_auth",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "test_auth": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "testWorkflowAuth"
          },
          "then": "end",
          "x-base44": {
            "title": "Probe auth context",
            "description": "Report isAuthenticated / user / headers from the runtime call"
          }
        }
      }
    ]
  }
}